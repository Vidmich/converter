{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Converter",
  "version": "0.1.0",
  "identifier": "com.wizard.converter",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Converter",
        "width": 720,
        "height": 480,
        "minWidth": 420,
        "minHeight": 300
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Dmytro Vidmych",
    "copyright": "© 2026 Dmytro Vidmych",
    "category": "Utility",
    "shortDescription": "Back-of-the-envelope rate and size converter",
    "longDescription": "Type rough quantities such as \"100M photos / day\" or \"4 MB * 100M/day\" and see them as round numbers per year, per day and per second, plus bit rates for data sizes.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
